{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        },
        "enabled": true
    },
    "css": {
        "formatter": {
            "quoteStyle": "double"
        }
    },
    "files": {
        "ignoreUnknown": false,
        "includes": ["**", "!**/node_modules", "!**/.yarn", "!**/dist", "!**/static"]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "lineEnding": "lf"
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single"
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "a11y": "off",
            "correctness": {
                "noUnusedImports": "error",
                "noUnusedVariables": "warn",
                "useExhaustiveDependencies": "off",
                "noUnusedFunctionParameters": "off"
            },
            "suspicious": {
                "noArrayIndexKey": "warn",
                "noExplicitAny": "off",
                "noImplicitAnyLet": "off",
                "noVar": "error"
            }
        }
    },
    // Overrides for tests
    "overrides": [
        {
            "includes": ["**/*.{test,spec}.{ts,tsx}"],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noAssignInExpressions": "off"
                    },
                    "style": {
                        "noNonNullAssertion": "off"
                    }
                }
            }
        },
        {
            "includes": ["**/*.stories.{tsx,jsx}"],
            "linter": {
                "rules": {
                    "correctness": {
                        // Neccessary for explicitly setting children to undefined when we need to.
                        "noChildrenProp": "off"
                    }
                }
            }
        }
    ],
    "vcs": {
        "clientKind": "git",
        "enabled": false,
        "useIgnoreFile": true
    }
}
